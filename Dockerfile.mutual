FROM python:3.10-slim

WORKDIR /app

# Install system dependencies if required (libomp-dev for lightgbm)
RUN apt-get update && apt-get install -y build-essential curl libomp-dev && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements_mutual.txt .
RUN pip install --no-cache-dir -r requirements_mutual.txt

# Copy source code, pre-synced database, and CIBIL model artifacts
COPY mutual_2_api.py .
COPY master_funds_database.csv .
COPY last_sync.txt .
COPY sync_engine.py .
COPY *.pkl ./

# Expose port
EXPOSE 5050

# Run the API via gunicorn (production WSGI server)
RUN pip install gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:5050", "--timeout", "120", "mutual_2_api:app"]
